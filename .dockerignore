# Dependencias (se instalan en build)
vendor/
node_modules/

# Assets compilados (se compilan en build)

# Entornos
.env
.env.*
!.env.example

# Control de versiones
.git/
.gitignore
.gitattributes

# Docker (no necesarios dentro de la imagen)
docker-compose*.yml
Dockerfile
INSTALL.md
patches/


# =============================================================================
# Gestor centralizado de usuarios LDAP — Configuración
# Copia este fichero a .env y rellena todos los valores antes de arrancar.
# =============================================================================

# ── Centro ────────────────────────────────────────────────────────────────────
CENTER_NAME="IES Nombre del Centro"

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_KEY=                              # Se genera automáticamente en primer arranque
APP_URL=https://gestion.tucentro.es  # URL pública completa, sin barra final
EXTERNAL_PORT=8083                   # Puerto expuesto al host

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_PASSWORD=CambiaEsto_Seguro123!
DB_ROOT_PASSWORD=CambiaEsto_Root456!

# ── LDAP ─────────────────────────────────────────────────────────────────────
LDAP_DOMAIN=tucentro.es              # Tu dominio → genera dc=tucentro,dc=es
LDAP_ADMIN_PASSWORD=AdminLDAP_789!
LDAP_READONLY_PASSWORD=ReadOnly_321!

# Exposición del puerto LDAP al host:
#   127.0.0.1 → solo apps del mismo servidor
#   0.0.0.0   → apps en otros servidores de la red
LDAP_BIND_INTERFACE=0.0.0.0
LDAP_EXPOSE_PORT=389

# ── Correo electrónico (SMTP) ─────────────────────────────────────────────────
MAIL_HOST=smtp.tucentro.es
MAIL_PORT=587
MAIL_USERNAME=gestion@tucentro.es
MAIL_PASSWORD=ContraseñaSMTP!
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=gestion@tucentro.es
MAIL_FROM_NAME="${CENTER_NAME}"

# =============================================================================
# No modificar salvo que sepas lo que haces
# =============================================================================
LOG_CHANNEL=daily
LOG_LEVEL=error
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
LDAP_LOGGING=false
LDAP_CONNECTION=default
LDAP_PORT=389
LDAP_SSL=false
LDAP_TLS=false
LDAP_TIMEOUT=5
